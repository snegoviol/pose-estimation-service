# docker/Dockerfile.worker-default
# ==================================================================================================

FROM ghcr.io/prefix-dev/pixi:0.71.1-noble AS worker-default
RUN pixi global install git --with git-lfs

WORKDIR /appdir

COPY pixi.toml pixi.lock ./
COPY packages/ ./packages/
RUN pixi install -e worker-default

CMD ["pixi", "run", "-e", "worker-default", "python", "-m", "worker_default.main"]

