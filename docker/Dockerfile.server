# ==================================================================================================
# docker/Dockerfile.server
# ==================================================================================================

FROM ghcr.io/prefix-dev/pixi:0.71.1-noble AS server
RUN pixi global install curl

WORKDIR /appdir

COPY pixi.toml pixi.lock ./
COPY packages/ ./packages/
COPY migrations/ ./migrations/
RUN pixi install -e server

CMD ["pixi", "run", "-e", "server", "python", "-m", "server.main"]

# ==================================================================================================
